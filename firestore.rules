rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalog: anyone can read (so customers can browse),
    // only a logged-in admin can add/edit/delete items.
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{prodId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create an order and fetch ONE order
    // by its exact ID (for order tracking) — but nobody can
    // browse/list all orders unless they're the logged-in admin.
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
